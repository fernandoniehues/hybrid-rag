# Embeddings
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-...

# LLM para reranking e geração.
# Vazio = OpenAI. Para qualquer API compatível com o padrão OpenAI
# (Groq, DeepSeek, Together, vLLM local), aponte a base e a chave:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   GROQ_API_KEY=gsk_...
LLM_BASE_URL=
GROQ_API_KEY=

# Porta do Postgres no host (mude se a 5433 já estiver ocupada)
DB_PORT=5433

# Só necessário para rodar a aplicação fora do Docker
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
